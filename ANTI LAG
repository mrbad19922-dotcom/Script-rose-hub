-- ===== BẬT / TẮT =====
local function setEnabled(state)
	enabled = state
	if state then
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 1e9
		stack = { Workspace, Lighting }
		toggleBtn.Text = "Tắt Anti Lag"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(70, 110, 230)
	else
		stack = {}
		Lighting.GlobalShadows = originalGlobalShadows
		Lighting.FogEnd = originalFogEnd
		toggleBtn.Text = "Bật Anti Lag"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
	end
end

toggleBtn.MouseButton1Click:Connect(function()
	setEnabled(not enabled)
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == CONFIG.ToggleKey then
		setEnabled(not enabled)
	end
end)

-- Cập nhật số FPS lên menu
task.spawn(function()
	while true do
		fpsLabel.Text = "FPS: " .. currentFPS
