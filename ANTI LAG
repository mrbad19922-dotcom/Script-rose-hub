-- LocalScript: Anti Lag v2 (client-side)
-- Đặt trong StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- ===== CẤU HÌNH =====
local CONFIG = {
	FrameBudgetMs = 4,      -- ms tối đa mỗi frame cho anti lag (máy yếu thì giảm xuống 2)
	CleanRadius = 120,      -- vật thể xa hơn mức này sẽ bị ẩn hình
	ToggleKey = Enum.KeyCode.RightControl,
}

local POST_EFFECT = {
	BloomEffect = true, BlurEffect = true, ColorCorrectionEffect = true,
	SunRaysEffect = true, DepthOfFieldEffect = true,
}
local PARTICLE = {
	ParticleEmitter = true, Trail = true, Beam = true,
	Fire = true, Smoke = true, Sparkles = true,
}

-- ===== TRẠNG THÁI =====
local BUDGET = CONFIG.FrameBudgetMs / 1000
local enabled = false
local stack = {}
local parts, partInfo, partCursor = {}, {}, 1
local effects, effectInfo, effectCursor = {}, {}, 1
local originalFogEnd = Lighting.FogEnd
local originalGlobalShadows = Lighting.GlobalShadows

-- ===== TIỆN ÍCH =====
local function getRootPos()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root and root.Position
end

-- Nhân vật (mình, người chơi khác, NPC) luôn giữ nguyên để không mất mục tiêu
local function isProtected(part)
	local node = part
	while node and node ~= Workspace do
		if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then
			return true
		end
		node = node.Parent
	end
	return false
end

-- ===== PHÂN LOẠI VẬT THỂ =====
local function classify(obj)
	if obj:IsA("BasePart") then
		if not obj:IsA("Terrain") and partInfo[obj] == nil then
			partInfo[obj] = { hidden = false }
			parts[#parts + 1] = obj
		end
	elseif obj:IsA("Atmosphere") or POST_EFFECT[obj.ClassName] or PARTICLE[obj.ClassName] then
		if effectInfo[obj] == nil then
			local prop = obj:IsA("Atmosphere") and "Density" or "Enabled"
			effectInfo[obj] = {
				prop = prop,
				value = obj[prop],
				off = (prop == "Density") and 0 or false,
			}
			effects[#effects + 1] = obj
		end
	end
end

-- ===== XỬ LÝ TỪNG PART (mỗi lần một ít) =====
-- Trả về true nếu giữ lại trong danh sách, false nếu bỏ
local function stepPart(p)
	local info = partInfo[p]
	local root = getRootPos()
	local far = root and (p.Position - root).Magnitude > CONFIG.CleanRadius

	if enabled and p.Parent and far and not isProtected(p) then
		if not info.hidden then
			info.hidden = true
			info.cast = p.CastShadow
			info.ltm = p.LocalTransparencyModifier
		end
		-- Game có reset lại thì lần kiểm tra sau sẽ ẩn lại
		p.LocalTransparencyModifier = 1
		p.CastShadow = false
		return true
	end

	-- Gần lại, được bảo vệ, hoặc tắt anti lag: trả về trạng thái gốc
	if info.hidden then
		info.hidden = false
		p.LocalTransparencyModifier = info.ltm
		p.CastShadow = info.cast
	end

	if enabled and p.Parent then return true end
	partInfo[p] = nil
	return false
end

-- ===== XỬ LÝ TỪNG HIỆU ỨNG (mỗi lần một ít) =====
local function stepEffect(obj)
	local info = effectInfo[obj]
	if enabled and obj.Parent then
		-- Game bật lại thì tắt ngay, không cần kết nối sự kiện nên nhẹ máy
		if obj[info.prop] ~= info.off then
			obj[info.prop] = info.off
		end
		return true
	end
	obj[info.prop] = info.value
	effectInfo[obj] = nil
	return false
end

-- Duyệt danh sách trong ngân sách thời gian, bỏ phần tử đã không còn dùng
local function processList(list, step, cursor, t0)
	local i = cursor
	while i <= #list and os.clock() - t0 < BUDGET do
		if step(list[i]) then
			i += 1
		else
			local last = #list
			list[i] = list[last]
			list[last] = nil
		end
	end
	if i > #list then return 1 end -- hết một vòng, quay lại đầu
	return i
end

-- Quét cây Workspace/Lighting dần dần, không GetDescendants một lần
local function traverse(t0)
	while #stack > 0 and os.clock() - t0 < BUDGET do
		local obj = stack[#stack]
		stack[#stack] = nil
		classify(obj)
		for _, child in ipairs(obj:GetChildren()) do
			stack[#stack + 1] = child
		end
	end
end

-- ===== VÒNG LẶP CHÍNH =====
RunService.Heartbeat:Connect(function()
	local t0 = os.clock()
	if enabled then
		if Lighting.GlobalShadows then
			Lighting.GlobalShadows = false
		end
		if #stack > 0 then
			traverse(t0)
		end
	end
	partCursor = processList(parts, stepPart, partCursor, t0)
	effectCursor = processList(effects, stepEffect, effectCursor, t0)
end)

-- Vật thể mới xuất hiện khi đang bật sẽ được xử lý ngay
Workspace.DescendantAdded:Connect(function(obj)
	if enabled then classify(obj) end
end)
Lighting.DescendantAdded:Connect(function(obj)
	if enabled then classify(obj) end
end)

-- ===== FPS COUNTER =====
local fpsCount, fpsTimer, currentFPS = 0, 0, 0

RunService.RenderStepped:Connect(function(dt)
	fpsCount += 1
	fpsTimer += dt
	if fpsTimer >= 0.5 then
		currentFPS = math.floor(fpsCount / fpsTimer)
		fpsCount = 0
		fpsTimer = 0
	end
end)

