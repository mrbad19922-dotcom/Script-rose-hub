frame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
frame.BorderSizePixel = 0
frame.Parent = screenGui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local stroke = Instance.new("UIStroke", frame)
stroke.Color = Color3.fromRGB(90, 140, 255)
stroke.Thickness = 1

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -12, 0, 26)
title.Position = UDim2.fromOffset(12, 6)
title.BackgroundTransparency = 1
title.Text = "Anti Lag"
title.Font = Enum.Font.GothamBold
title.TextSize = 15
title.TextColor3 = Color3.fromRGB(235, 235, 245)
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

local fpsLabel = Instance.new("TextLabel")
fpsLabel.Size = UDim2.new(1, -12, 0, 20)
fpsLabel.Position = UDim2.fromOffset(12, 30)
fpsLabel.BackgroundTransparency = 1
fpsLabel.Text = "FPS: --"
fpsLabel.Font = Enum.Font.Gotham
fpsLabel.TextSize = 13
fpsLabel.TextColor3 = Color3.fromRGB(120, 255, 170)
fpsLabel.TextXAlignment = Enum.TextXAlignment.Left
fpsLabel.Parent = frame

local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(1, -24, 0, 36)
toggleBtn.Position = UDim2.fromOffset(12, 60)
toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
toggleBtn.Text = "Bật Anti Lag"
toggleBtn.Font = Enum.Font.GothamSemibold
toggleBtn.TextSize = 14
toggleBtn.TextColor3 = Color3.fromRGB(240, 240, 250)
toggleBtn.BorderSizePixel = 0
toggleBtn.AutoButtonColor = false
toggleBtn.Parent = frame
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 8)

local function setEnabled(state)
	antiLagEnabled = state
	if state then
		buildQueue()
		applyEffects(true)
		toggleBtn.Text = "Tắt Anti Lag"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(70, 110, 230)
	else
		restoreParts()
		applyEffects(false)
		toggleBtn.Text = "Bật Anti Lag"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
	end
end

toggleBtn.MouseButton1Click:Connect(function()
	setEnabled(not antiLagEnabled)
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == CONFIG.ToggleKey then
		setEnabled(not antiLagEnabled)
	end
end)

-- Hiệu ứng mới xuất hiện khi đang bật Anti Lag cũng sẽ bị tắt
Workspace.DescendantAdded:Connect(function(obj)
	if antiLagEnabled then task.defer(disableEffect, obj) end
end)
Lighting.ChildAdded:Connect(function(obj)
	if antiLagEnabled then task.defer(disableEffect, obj) end
end)

-- Cập nhật FPS lên menu
task.spawn(function()
	while true do
		fpsLabel.Text = "FPS: " .. currentFPS
		task.wait(0.25)
	end
end)
