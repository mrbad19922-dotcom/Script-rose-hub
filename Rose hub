local function throwOnce(char)
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
    local cam = workspace.CurrentCamera
    if cam then
        clickAt(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    end
end

-- Menu Thú cưng đang mở hay không (thấy nút Trang bị tốt nhất)
local function isPetMenuOpen()
    return findButton(EQUIP_BEST_KEYWORDS) ~= nil
end

local function doEquip()
    local wasOpen = isPetMenuOpen()

    if not wasOpen then
        local animalBtn = findButton(ANIMAL_KEYWORDS)
        if not animalBtn then
            setStatus("Không thấy nút Động vật")
            return
        end
        setStatus("Đang mở menu Động vật...")
        clickGui(animalBtn)
        waitMaster(0.8)
    end

    local equipBtn = findButton(EQUIP_BEST_KEYWORDS)
    if equipBtn then
        setStatus("Đang trang bị tốt nhất...")
        clickGui(equipBtn)
        waitMaster(0.5)
    else
        setStatus("Không thấy nút Trang bị tốt nhất")
    end

    -- Đóng menu nếu chính script đã mở
    if not wasOpen then
        local animalBtn = findButton(ANIMAL_KEYWORDS)
        if animalBtn then
            clickGui(animalBtn)
            waitMaster(0.3)
        end
    end

    if Pet.UseRemote then
        fireRemotes({"pet", "equip", "best"}, {"EquipBest", "EquipAllBest"})
    end
end

local function doSell()
    setStatus("Đang đi bán đồ...")
    if not moveTo(Sell.Pos) then return end
    waitMaster(0.5)

    local sellBtn = findButton(SELL_ALL_KEYWORDS)
    if sellBtn then
        clickGui(sellBtn)
    else
        setStatus("Không thấy nút Bán tất cả")
    end

    if Sell.UseRemote then
        fireRemotes({"sell", "bay", "store"}, {"SellAll", "Sell"})
    end
    waitMaster(Sell.WaitAfter)
end

local function doReset()
    setStatus("Đang reset nhân vật...")
    local oldChar = localPlayer.Character
    if oldChar then
        pcall(function() oldChar:BreakJoints() end)
    end
    local t0 = tick()
    repeat
        task.wait(0.2)
        local c = localPlayer.Character
        local ready = c and c ~= oldChar and c:FindFirstChild("HumanoidRootPart")
    until ready or tick() - t0 > Reset.RespawnTimeout or not alive
    waitMaster(Reset.WaitAfter)
end

