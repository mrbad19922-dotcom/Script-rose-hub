local Pages, tabButtons = {}, {}

local function showTab(name)
    for n, p in pairs(Pages) do p.Visible = (n == name) end
    for n, b in pairs(tabButtons) do
        b.BackgroundColor3 = (n == name) and Color3.fromRGB(70, 70, 95) or Color3.fromRGB(38, 38, 48)
    end
end

local tabIndex = 0
local function makeTab(name, text)
    tabIndex += 1
    local b = Instance.new("TextButton", TabBar)
    b.Size = UDim2.new(1 / 6, -3, 1, -6)
    b.Position = UDim2.new((tabIndex - 1) / 6, 2, 0, 3)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 10
    b.TextColor3 = Color3.fromRGB(230, 230, 240)
    b.Text = text
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    tabButtons[name] = b
    b.MouseButton1Click:Connect(function() showTab(name) end)

    local page = Instance.new("ScrollingFrame", Body)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Position = UDim2.new(0, 0, 0, 34)
    page.Size = UDim2.new(1, 0, 1, -34)
    page.ScrollBarThickness = 4
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = false

    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0, 6)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    local pad = Instance.new("UIPadding", page)
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingBottom = UDim.new(0, 6)

    Pages[name] = page
    return page
end

local orders = {}
local function nextOrder(page)
    orders[page] = (orders[page] or 0) + 1
    return orders[page]
end

local function makeRow(page, h)
    local f = Instance.new("Frame", page)
    f.BackgroundColor3 = Color3.fromRGB(18, 18, 23)
    f.Size = UDim2.new(0, 296, 0, h or 30)
    f.LayoutOrder = nextOrder(page)
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    return f
end

local function makeLabel(parent, text, size, pos)
    local l = Instance.new("TextLabel", parent)
    l.BackgroundTransparency = 1
    l.Size = size
    l.Position = pos
    l.Font = Enum.Font.Gotham
    l.TextSize = 11
    l.TextColor3 = Color3.fromRGB(200, 200, 210)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Text = text
    return l
end

local function addToggle(page, text, tbl, key)
    local r = makeRow(page)
    makeLabel(r, text, UDim2.new(0.65, 0, 1, 0), UDim2.new(0, 10, 0, 0))
    local b = Instance.new("TextButton", r)
    b.Size = UDim2.new(0, 60, 0, 22)
    b.Position = UDim2.new(1, -68, 0.5, -11)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local function refresh()
        b.Text = tbl[key] and "BẬT" or "TẮT"
        b.BackgroundColor3 = tbl[key] and Color3.fromRGB(50, 160, 100) or Color3.fromRGB(70, 70, 85)
    end
    b.MouseButton1Click:Connect(function()
        tbl[key] = not tbl[key]
        refresh()
    end)
    refresh()
end

local function addNumber(page, text, tbl, key, minV)
    local r = makeRow(page)
    makeLabel(r, text, UDim2.new(0.65, 0, 1, 0), UDim2.new(0, 10, 0, 0))
    local box = Instance.new("TextBox", r)
    box.Size = UDim2.new(0, 60, 0, 22)
    box.Position = UDim2.new(1, -68, 0.5, -11)
    box.Font = Enum.Font.Gotham
    box.TextSize = 11
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
    box.Text = tostring(tbl[key])
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n and n >= minV then tbl[key] = n end
        box.Text = tostring(tbl[key])
    end)
end

local function addVector(page, text, tbl, key)
    local r = makeRow(page)
    makeLabel(r, text, UDim2.new(0, 100, 1, 0), UDim2.new(0, 8, 0, 0))
    local v = tbl[key]
    local c = {v.X, v.Y, v.Z}
    for i = 1, 3 do
        local box = Instance.new("TextBox", r)
        box.Size = UDim2.new(0, 56, 0, 22)
        box.Position = UDim2.new(0, 108 + (i - 1) * 62, 0.5, -11)
        box.Font = Enum.Font.Gotham
        box.TextSize = 10
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
        box.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
        box.Text = tostring(c[i])
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
        box.FocusLost:Connect(function()
            local n = tonumber(box.Text)
            if n then c[i] = n end
            tbl[key] = Vector3.new(c[1], c[2], c[3])
            box.Text = tostring(c[i])
        end)
    end
end

