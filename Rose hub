local function runAntiLag()
    if not settings.antiLagEnabled then return end
    task.spawn(function()
        pcall(function()
            Lighting.GlobalShadows = false
            local items = workspace:GetDescendants()
            for i = 1, #items do
                if not settings.antiLagEnabled then break end
                local v = items[i]
                if v and v.Parent then
                    if v:IsA("Model") and (v.Name:lower():find("pet") or v.Name:lower():find("animal")) then
                        if localPlayer.Character and not v:IsAncestorOf(localPlayer.Character) then
                            for _, part in ipairs(v:GetDescendants()) do
                                if part:IsA("BasePart") or part:IsA("Decal") then
                                    part.Transparency = 1
                                end
                            end
                        end
                    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
                        v.Enabled = false
                    end
                end
                if i % 60 == 0 then RunService.RenderStepped:Wait() end
            end
        end)
    end)
end

