local function clickAt(x, y)
    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.05)
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function clickGui(gui)
    local offsetY = 0
    local sg = gui:FindFirstAncestorWhichIsA("ScreenGui")
    if sg and not sg.IgnoreGuiInset then
        offsetY = GuiService:GetGuiInset().Y
    end
    clickAt(
        gui.AbsolutePosition.X + gui.AbsoluteSize.X / 2,
        gui.AbsolutePosition.Y + gui.AbsoluteSize.Y / 2 + offsetY
    )
end

local function getAllText(obj)
    local t = ""
    if obj:IsA("TextButton") or obj:IsA("TextLabel") then
        t = obj.Text or ""
    end
    for _, c in ipairs(obj:GetDescendants()) do
        if c:IsA("TextLabel") or c:IsA("TextButton") then
            t = t .. " " .. (c.Text or "")
        end
    end
    return t:lower()
end

-- Tìm nút đang hiện có chữ hoặc tên khớp từ khóa
local function findButton(keywords)
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and gui.Visible and gui.AbsoluteSize.X > 0 then
            -- Bỏ qua chính khung chứa script
            if not gui:IsDescendantOf(ScreenGui) then
                local text = getAllText(gui)
                local name = gui.Name:lower()
                for _, kw in ipairs(keywords) do
                    if text:find(kw, 1, true) or name:find(kw, 1, true) then
                        return gui
                    end
                end
            end
        end
    end
    return nil
end

local function fireRemotes(keywords, args)
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local name = v.Name:lower()
            for _, kw in ipairs(keywords) do
                if name:find(kw, 1, true) then
                    for _, a in ipairs(args) do
                        pcall(function() v:FireServer(a) end)
                    end
                    break
                end
            end
        end
    end
end

local function waitMaster(seconds)
    local t0 = tick()
    while alive and Core.Master and tick() - t0 < seconds do
        RunService.Heartbeat:Wait()
    end
end

-- ================= DI CHUYỂN =================
local function moveTo(targetPos)
    for _ = 1, Misc.MoveRetries do
        if not (alive and Core.Master) then return false end

        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        local dist = (hrp.Position - targetPos).Magnitude
        if dist < 3 then return true end

        local duration = dist / math.max(Misc.TweenSpeed, 10)
        local tween = TweenService:Create(
            hrp,
            TweenInfo.new(duration, Enum.EasingStyle.Linear),
            {CFrame = CFrame.new(targetPos)}
        )

        local done = false
        local conn = tween.Completed:Connect(function() done = true end)
        tween:Play()

        local deadline = tick() + duration + Misc.MoveTimeout
        while not done and alive and Core.Master and tick() < deadline do
            RunService.Heartbeat:Wait()
        end

        tween:Cancel()
        conn:Disconnect()

        local nowHrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if nowHrp and (nowHrp.Position - targetPos).Magnitude < 4 then
            return true
        end
    end
    return false
end

