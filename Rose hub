task.spawn(function()
    while alive do
        task.wait(X2.Interval)
        if X2.Enabled then
            pcall(function()
                local btn = findButton(X2_KEYWORDS)
                if btn then
                    clickGui(btn)
                    x2Status.Text = "Đã bấm x2: " .. btn.Name
                    task.wait(X2.ClickDelay)
                end
            end)
        end
    end
end)

-- ================= VÒNG LẶP AUTO FARM =================
task.spawn(function()
    local sellCount, cycles = 0, 0
    while alive do
        task.wait(0.2)
        if not (Core.Master and Throw.Enabled) then continue end

        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum and hum.Health > 0) then continue end

        if Sell.Enabled and sellCount >= Sell.EveryCycles then
            pcall(doSell)
            sellCount = 0
            if not Core.Master then continue end
        end

        setStatus("Đang về vạch ném...")
        if not moveTo(Throw.Pos) then
            setStatus("Không tới được vạch, thử lại...")
            waitMaster(1)
            continue
        end

        cycles += 1
        if Pet.Enabled and cycles % Pet.EveryCycles == 0 then
            pcall(doEquip)
            if not Core.Master then continue end
        end

        setStatus("Đang ném...")
        for _ = 1, Throw.ThrowsPerCycle do
            if not Core.Master then break end
            throwOnce(localPlayer.Character)
            waitMaster(Throw.ThrowGap)
        end

        sellCount += 1
        waitMaster(Throw.WaitAfter)

        if Reset.Enabled and Core.Master then
            pcall(doReset)
        end
    end
end)
