-- Hàm lưu cấu hình
local function saveConfig()
    local data = {
        tweenSpeed = settings.tweenSpeed,
        throwChargeTime = settings.throwChargeTime,
        waitTimeAfterThrow = settings.waitTimeAfterThrow,
        waitTimeAfterRespawn = settings.waitTimeAfterRespawn,
        antiAfkEnabled = settings.antiAfkEnabled,
        antiLagEnabled = settings.antiLagEnabled
    }
    if settings.savedPos then
        data.savedPos = {settings.savedPos.X, settings.savedPos.Y, settings.savedPos.Z}
    end
    pcall(function()
        writefile(configFileName, HttpService:JSONEncode(data))
    end)
end

-- Hàm đọc cấu hình
local function loadConfig()
    pcall(function()
        if readfile and isfile and isfile(configFileName) then
            local data = HttpService:JSONDecode(readfile(configFileName))
            if data then
                settings.tweenSpeed = data.tweenSpeed or settings.tweenSpeed
                settings.throwChargeTime = data.throwChargeTime or settings.throwChargeTime
                settings.waitTimeAfterThrow = data.waitTimeAfterThrow or settings.waitTimeAfterThrow
                settings.waitTimeAfterRespawn = data.waitTimeAfterRespawn or settings.waitTimeAfterRespawn
                settings.antiAfkEnabled = data.antiAfkEnabled or settings.antiAfkEnabled
                settings.antiLagEnabled = data.antiLagEnabled or settings.antiLagEnabled
                if data.savedPos then
                    settings.savedPos = CFrame.new(data.savedPos[1], data.savedPos[2], data.savedPos[3])
                end
            end
        end
    end)
end

