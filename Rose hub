-- Hàm kích hoạt ném
local function triggerThrow(char)
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
    local cam = workspace.CurrentCamera
    if cam then
        local centerX, centerY = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
    end
end

-- Hàm di chuyển chống lỗi (Hỗ trợ Tween mượt hoặc Teleport)
local function moveToTarget(targetCFrame)
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if settings.teleportMode then
        hrp.CFrame = targetCFrame
        task.wait(settings.teleportDelay)
    else
        local dist = (hrp.Position - targetCFrame.Position).Magnitude
        if dist < 2 then return end
        local tween = TweenService:Create(hrp, TweenInfo.new(dist / settings.tweenSpeed, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
        tween:Play()
        while tween.PlaybackState == Enum.PlaybackState.Playing do
            if not settings.autoFarmEnabled then tween:Cancel() return end
            task.wait(0.05)
        end
    end
end

-- Hàm tự động trang bị Pet (Kích hoạt Remote / Click nút tối ưu pet)
local function autoEquipBestPet()
    if not settings.autoEquipPet then return end
    pcall(function()
        -- Quét và tìm Remote liên quan đến Pet hoặc nút trang bị tốt nhất
        for _, rem in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if rem:IsA("RemoteEvent") and (rem.Name:lower():find("pet") or rem.Name:lower():find("equip") or rem.Name:lower():find("best")) then
                rem:FireServer("EquipBest")
                rem:FireServer("EquipAllBest")
            end
        end
    end)
end

-- Hàm tự động bán đồ tại X:55, Y:6, Z:-28[span_5](start_span)[span_5](end_span)
local function performAutoSell()
    StatusBox.Text = "Đang di chuyển đi bán đồ..."
    moveToTarget(CFrame.new(SELL_POS))
    task.wait(0.5)

    StatusBox.Text = "Đang kích hoạt bán tất cả..."
    pcall(function()
        -- Tìm Remote Event bán hàng trong game để gọi trực tiếp (chính xác 100%)
        for _, rem in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if rem:IsA("RemoteEvent") and (rem.Name:lower():find("sell") or rem.Name:lower():find("bay") or rem.Name:lower():find("store")) then
                rem:FireServer("SellAll")
                rem:FireServer("Sell")
            end
        end
        -- Mô phỏng click vào màn hình hoặc nút Bán tất cả[span_6](start_span)[span_6](end_span)
        local cam = workspace.CurrentCamera
        if cam then
            local cx, cy = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
        end
    end)

    task.wait(settings.sellWaitTime)
end

-- Vòng lặp chính quản lý Ném - Bán - Trang bị Pet
task.spawn(function()
    local throwCounter = 0

    while true do
        task.wait(0.15)
        if settings.autoFarmEnabled then
            local char = localPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if char and hrp and hum and hum.Health > 0 then
                -- 1. Kiểm tra xem đã đến lúc đi bán đồ chưa
                if throwCounter >= settings.throwsBeforeSell then
                    performAutoSell()
                    throwCounter = 0
                    if not settings.autoFarmEnabled then continue end
                end

                -- 2. Di chuyển về điểm ném cố định (X:0, Y:6, Z:-45)
                StatusBox.Text = "Đang di chuyển tới vạch ném..."
                moveToTarget(CFrame.new(THROW_POS))
                if not settings.autoFarmEnabled then continue end

                task.wait(0.2)

                -- 3. Trang bị Pet tốt nhất (qua Remote)
                autoEquipBestPet()

                -- 4. Gồng lực và ném
                StatusBox.Text = "Đang gồng lực (" .. settings.throwChargeTime .. "s)..."
                triggerThrow(char)

                local t0 = tick()
                while tick() - t0 < settings.throwChargeTime do
                    if not settings.autoFarmEnabled then break end
                    RunService.RenderStepped:Wait()
                end
                if not settings.autoFarmEnabled then continue end

                StatusBox.Text = "Đang ném..."
                triggerThrow(char)
                throwCounter = throwCounter + 1

                task.wait(settings.waitTimeAfterThrow)
                if not settings.autoFarmEnabled then continue end

                -- 5. Reset nhân vật để về điểm spawn/chuẩn bị lượt mới
                StatusBox.Text = "Đang Reset nhân vật..."
                if char:FindFirstChildOfClass("Humanoid") then
                    char:FindFirstChildOfClass("Humanoid").Health = 0
                end

                localPlayer.CharacterAdded:Wait()
                task.wait(settings.waitTimeAfterRespawn)
            end
        end
    end
end)
