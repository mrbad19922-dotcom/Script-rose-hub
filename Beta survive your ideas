-- ===== VÒNG LẶP CHÍNH (nhẹ, chạy mỗi frame) =====
RunService.Heartbeat:Connect(function(dt)
	if S.rainbow then
		paintAccent(accentNow())
	end
	if not char or not hum or not root or not hum.Parent or hum.Health <= 0 then return end

	hum.UseJumpPower = false

	-- Chạy nhanh: chỉ ghi khi cần, và trả lại tốc độ gốc một lần khi tắt
	if S.fastRun then
		local target = math.min(S.walk, MAX_WALK)
		if hum.WalkSpeed ~= target then hum.WalkSpeed = target end
		wasFast = true
	elseif wasFast then
		hum.WalkSpeed = origWalk
		wasFast = false
	end

	-- Nhảy cao: tương tự chạy nhanh
	if S.highJump then
		local target = math.min(S.jump, MAX_JUMP)
		if hum.JumpHeight ~= target then hum.JumpHeight = target end
		wasHigh = true
	elseif wasHigh then
		hum.JumpHeight = origJump
		wasHigh = false
	end

	updateWater(dt)

	-- Anti Fling: giới hạn vận tốc bất thường
	if S.antiFling then
		local vel = root.AssemblyLinearVelocity
		if vel.Magnitude > 140 then
			root.AssemblyLinearVelocity = vel.Unit * 50
		end
		if root.AssemblyAngularVelocity.Magnitude > 20 then
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	-- Anti Fall Stun / Anti Ragdoll: giữ nhân vật không bị khóa ở PlatformStand
	if (S.antiFallStun or S.antiRagdoll) and hum.PlatformStand then
		hum.PlatformStand = false
	end
end)
