task.spawn(function()
	while true do
		task.wait(THROTTLE)

		-- Anti Fling: tắt va chạm với người chơi khác
		if S.antiFling then
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player and other.Character then
					for _, part in ipairs(other.Character:GetDescendants()) do
						if part:IsA("BasePart") and part.CanCollide then
							flingSet.set(part, false)
						end
					end
				end
			end
		end

		-- Anti Black Hole: gỡ lực hút gắn lên nhân vật mình
		if S.antiBlackHole and char then
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BodyMover") then
					obj:Destroy()
				elseif obj:IsA("VectorForce") or obj:IsA("LineForce") then
					obj.Enabled = false
				end
			end
		end
	end
end)

-- ===== ANTI LAG (xử lý dần, có khôi phục) =====
local EFFECT_CLASSES = {
	ParticleEmitter = true, Trail = true, Smoke = true,
	Fire = true, Sparkles = true, Beam = true,
}

local antiLagConn
local lagOrig = setmetatable({}, { __mode = "k" })
local lagQueue = {}
local draining = false
local prevQuality, prevShadows

local function inCharacter(obj)
	local cur = obj
	while cur and cur ~= workspace do
		if cur:IsA("Model") and Players:GetPlayerFromCharacter(cur) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function stripOne(obj)
	if not obj.Parent then return end
	if not EFFECT_CLASSES[obj.ClassName] then return end
	if inCharacter(obj) then return end
	if lagOrig[obj] == nil then lagOrig[obj] = obj.Enabled end
	obj.Enabled = false
end

local function drain()
	if draining then return end
	draining = true
	task.spawn(function()
		local n = 0
		while #lagQueue > 0 and S.antiLag do
			local obj = table.remove(lagQueue)
			pcall(stripOne, obj)
			n += 1
			if n % 200 == 0 then task.wait() end
		end
		draining = false
	end)
end

toggleAntiLag = function()
	if S.antiLag then
		pcall(function()
			prevQuality = settings().Rendering.QualityLevel
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)
		prevShadows = Lighting.GlobalShadows
		Lighting.GlobalShadows = false

		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("PostEffect") then
				if lagOrig[v] == nil then lagOrig[v] = v.Enabled end
				v.Enabled = false
			end
		end

		if not antiLagConn then
			antiLagConn = workspace.DescendantAdded:Connect(function(obj)
				if S.antiLag then
					lagQueue[#lagQueue + 1] = obj
					drain()
				end
			end)
		end

		for _, d in ipairs(workspace:GetDescendants()) do
			lagQueue[#lagQueue + 1] = d
		end
		drain()
	else
		if antiLagConn then
			antiLagConn:Disconnect()
			antiLagConn = nil
		end
		table.clear(lagQueue)

		if prevShadows ~= nil then Lighting.GlobalShadows = prevShadows end
		if prevQuality then
			pcall(function() settings().Rendering.QualityLevel = prevQuality end)
		end
		for obj, was in pairs(lagOrig) do
			if typeof(obj) == "Instance" and obj.Parent then
				pcall(function() obj.Enabled = was end)
			end
		end
		table.clear(lagOrig)
	end
end

