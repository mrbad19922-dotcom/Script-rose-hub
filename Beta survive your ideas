-- ===== ĐI TRÊN NƯỚC (quét voxel mỗi 0.1 giây, không mỗi frame) =====
local function getWaterSurfaceY()
	local origin = root.Position
	local region = Region3.new(
		origin - Vector3.new(2, WATER_DEPTH, 2),
		origin + Vector3.new(2, 1, 2)
	):ExpandToGrid(4)

	local materials, occupancies = workspace.Terrain:ReadVoxels(region, 4)
	local size = materials.Size
	for y = size.Y, 1, -1 do
		for x = 1, size.X do
			for z = 1, size.Z do
				if materials[x][y][z] == Enum.Material.Water and occupancies[x][y][z] > 0.5 then
					return region.CFrame.Position.Y + (y - size.Y / 2) * 4 + 2
				end
			end
		end
	end
	return nil
end

local function updateWater(dt)
	if not S.waterWalk then return end

	local now = os.clock()
	if now - lastWaterCheck > 0.1 then
		lastWaterCheck = now
		waterY = getWaterSurfaceY()
	end
	if not waterY then return end

	local vel = root.AssemblyLinearVelocity
	if vel.Y <= 0 and root.Position.Y - waterY < hum.HipHeight + 3 then
		local targetY = waterY + hum.HipHeight + root.Size.Y / 2
		local newY = root.Position.Y + (targetY - root.Position.Y) * math.min(1, 15 * dt)
		root.CFrame = CFrame.new(root.Position.X, newY, root.Position.Z) * (root.CFrame - root.CFrame.Position)
		root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end
end

