local function makeCollideSet()
	local orig = setmetatable({}, { __mode = "k" })
	local o = {}
	function o.set(part, value)
		if orig[part] == nil then orig[part] = part.CanCollide end
		part.CanCollide = value
	end
	function o.restore()
		for part, was in pairs(orig) do
			if typeof(part) == "Instance" and part.Parent then
				pcall(function() part.CanCollide = was end)
			end
		end
		table.clear(orig)
	end
	return o
end

local noclipSet = makeCollideSet()
local flingSet = makeCollideSet()

