	char = c
	hum = c:WaitForChild("Humanoid")
	root = c:WaitForChild("HumanoidRootPart")
	origWalk = hum.WalkSpeed
	origJump = hum.JumpHeight
	wasFast, wasHigh = false, false
	waterY = nil

	table.insert(charConns, hum.StateChanged:Connect(function(_, newState)
		if S.antiRagdoll and (newState == Enum.HumanoidStateType.Ragdoll
			or newState == Enum.HumanoidStateType.FallingDown
			or newState == Enum.HumanoidStateType.Physics) then
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end))

	applyFallStun(S.antiFallStun)
end

