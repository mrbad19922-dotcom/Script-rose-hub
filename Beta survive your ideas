local function switch(parent, y, key, onChange)
	local track = new("TextButton", {
		Position = UDim2.new(1, -54, 0, y),
		Size = UDim2.fromOffset(42, 22),
		BackgroundColor3 = OFF,
		Text = "",
		AutoButtonColor = false,
	}, parent)
	corner(track, 11)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, track)
	corner(knob, 9)

	local function show()
		track.BackgroundColor3 = S[key] and accentNow() or OFF
		knob.Position = S[key] and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
	end

	track.Activated:Connect(function()
		S[key] = not S[key]
		show()
		if onChange then onChange() end
	end)

	table.insert(refreshers, show)
	table.insert(accentFns, function(c)
		if S[key] then track.BackgroundColor3 = c end
	end)
	show()
end

