-- Công tắc kiểu iOS/macOS
local function switch(parent, y, initial, onChange)
	local track = new("TextButton", {
		Position = UDim2.new(1, -52, 0, y),
		Size = UDim2.fromOffset(42, 22),
		BackgroundColor3 = OFF,
		Text = "",
		AutoButtonColor = false,
	}, parent)
	corner(track, 11)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, track)
	corner(knob, 9)

	local on = initial
	local function render()
		track.BackgroundColor3 = on and ACCENT or OFF
		knob.Position = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
	end
	track.Activated:Connect(function()
		on = not on
		render()
		onChange(on)
	end)
	render()
	onChange(on)
end

local function toggleCard(order, label, onToggle)
	local f = card(order, 40)
	new("TextLabel", {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -70, 1, 0),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = WHITE,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, f)
	switch(f, 9, false, onToggle)
end

local function sliderCard(order, label, min, max, default, onToggle, onSlide)
	local f = card(order, 66)

	local nameLbl = new("TextLabel", {
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -70, 0, 22),
		BackgroundTransparency = 1,
		TextColor3 = WHITE,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, f)

	switch(f, 8, false, onToggle)

	local hit = new("Frame", {
		Position = UDim2.fromOffset(12, 40),
		Size = UDim2.new(1, -24, 0, 18),
		BackgroundTransparency = 1,
		Active = true,
	}, f)

	local track = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = OFF,
		BorderSizePixel = 0,
	}, hit)
	corner(track, 3)

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = ACCENT,
		BorderSizePixel = 0,
	}, track)
	corner(fill, 3)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, track)
	corner(knob, 7)

	local dragging = false

	local function setValue(v)
		v = math.clamp(math.floor(v + 0.5), min, max)
		local pct = (v - min) / (max - min)
		fill.Size = UDim2.new(pct, 0, 1, 0)
		knob.Position = UDim2.new(pct, 0, 0.5, 0)
		nameLbl.Text = string.format("%s: %d", label, v)
		onSlide(v)
	end

	local function fromX(x)
		local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		setValue(min + pct * (max - min))
	end

	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(i.Position.X)
		end
	end)

	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(i.Position.X)
		end
	end)

	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	setValue(default)
end

