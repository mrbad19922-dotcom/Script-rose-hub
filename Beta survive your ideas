-- Script cho Delta (executor). Dán vào và execute khi đã vào game.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- ===== GIỚI HẠN =====
local MAX_WALK, MAX_JUMP = 40, 100

-- ===== TRẠNG THÁI =====
local S = {
	fastRun = false, walk = 30,
	highJump = false, jump = 50,
	waterWalk = false,
	infJump = false,
	noclip = false,
}

local WATER_DEPTH = 6

-- ===== NHÂN VẬT =====
local char, hum, root
local origWalk, origJump

local function bindCharacter(c)
	char = c
	hum = c:WaitForChild("Humanoid")
	root = c:WaitForChild("HumanoidRootPart")
	origWalk = hum.WalkSpeed
	origJump = hum.JumpHeight
end

bindCharacter(player.Character or player.CharacterAdded:Wait())
player.CharacterAdded:Connect(bindCharacter)

-- ===== ĐI TRÊN NƯỚC =====
local function getWaterSurfaceY()
	local origin = root.Position
	local region = Region3.new(
		origin - Vector3.new(2, WATER_DEPTH, 2),
		origin + Vector3.new(2, 1, 2)
	):ExpandToGrid(4)

	local materials, occupancies = workspace.Terrain:ReadVoxels(region, 4)
	local size = materials.Size
	for y = size.Y, 1, -1 do
		for x = 1, size.X do
			for z = 1, size.Z do
				if materials[x][y][z] == Enum.Material.Water and occupancies[x][y][z] > 0.5 then
					return region.CFrame.Position.Y + (y - size.Y / 2) * 4 + 2
				end
			end
		end
	end
	return nil
end

local function updateWater(dt)
	if not S.waterWalk then return end
	local waterY = getWaterSurfaceY()
	if not waterY then return end

	local vel = root.AssemblyLinearVelocity
	if vel.Y <= 0 and root.Position.Y - waterY < hum.HipHeight + 3 then
		local targetY = waterY + hum.HipHeight + root.Size.Y / 2
		local newY = root.Position.Y + (targetY - root.Position.Y) * math.min(1, 15 * dt)
		root.CFrame = CFrame.new(root.Position.X, newY, root.Position.Z) * (root.CFrame - root.CFrame.Position)
		root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end
end

-- ===== NHẢY VÔ HẠN =====
UIS.JumpRequest:Connect(function()
	if S.infJump and hum and hum.Parent and hum.Health > 0 then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

-- ===== NOCLIP (chạy trước physics) =====
RunService.Stepped:Connect(function()
	if not S.noclip or not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			part.CanCollide = false
		end
	end
end)

-- ===== VÒNG LẶP CHÍNH (dùng dt) =====
RunService.Heartbeat:Connect(function(dt)
	if not hum or not hum.Parent or hum.Health <= 0 then return end
	hum.UseJumpPower = false
	hum.WalkSpeed = S.fastRun and math.min(S.walk, MAX_WALK) or origWalk
	hum.JumpHeight = S.highJump and math.min(S.jump, MAX_JUMP) or origJump
	updateWater(dt)
end)

-- ===== HELPER GUI =====
local ACCENT = Color3.fromRGB(0, 122, 255)
local OFF = Color3.fromRGB(70, 70, 80)
local WHITE = Color3.new(1, 1, 1)
local GREY = Color3.fromRGB(160, 160, 170)

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end

local function corner(parent, r)
	new("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function stroke(parent, color)
	new("UIStroke", { Color = color, Thickness = 1, Transparency = 0.3 }, parent)
end

-- Kéo thả. onTap chạy khi bấm mà không kéo.
local function makeDrag(handle, target, onTap)
	local dragging, moved = false, false
	local startInput, startPos

	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			startInput = Vector2.new(i.Position.X, i.Position.Y)
			startPos = target.Position
		end
	end)

	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local dx = i.Position.X - startInput.X
			local dy = i.Position.Y - startInput.Y
			if math.abs(dx) + math.abs(dy) > 5 then moved = true end
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dx, startPos.Y.Scale, startPos.Y.Offset + dy)
		end
	end)

	UIS.InputEnded:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			if not moved and onTap then onTap() end
		end
	end)
end

